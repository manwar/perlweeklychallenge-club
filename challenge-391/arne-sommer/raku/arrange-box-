#! /usr/bin/env raku

unit sub MAIN (*@boxes, :v(:$verbose));

my @dims = @boxes.map: *.words>>.Numeric;
die "At least one box is required" unless @dims.elems;
die "Each box must have exactly two dimensions" unless all(@dims>>.elems) == 2;

my @sorted = @dims.sort: { (.[0], -.[1]) };

say ": Sorted: " ~ @sorted.map({ "[$_[0], $_[1]]" }).join(", ") if $verbose;
say ": Heights: " ~ @sorted>>[1].join(", ") if $verbose;

my @tails;
my @tail-indices;
my @prev;

for @sorted.kv -> $i, $box
{
  my $lo = @tails.first({ $_ >= $box[1] }, :k) // @tails.elems;
  @tails[$lo] := $box[1];
  @tail-indices[$lo] := $i;
  @prev[$i] = $lo > 0 ?? @tail-indices[$lo - 1] !! Nil;
}

my @chain;
my $i = @tail-indices[@tails.elems - 1];

while defined $i
{
  @chain.unshift: @sorted[$i];
  $i = @prev[$i];
}

say ": Chain: " ~ @chain.map({ "[$_[0], $_[1]]" }).join(" -> ") if $verbose;

say @chain.elems;