%!PS

% begin included library code
% see https://codeberg.org/Firedrake/postscript-libraries/
/test {
    /test.count test.count 1 add def
    {
        /test.pass test.pass 1 add def
    } {
        ( ) print
        test.count (....) cvs print
        (-fail) print
    } ifelse
    count /test.stack2 exch def
    test.stack test.stack2 ne {
        print
        (Warning: stack deviation ) print
        test.stack2 test.stack sub print
        (\r\n) print
    } if
} bind def

/s2a {
    [ exch { } forall ]
} bind def

/map { % array proc -> array
    2 dict begin
    /p exch def
    [ exch
      {
          p
      } forall
    ]
    end
} bind def

/deepeq {
    2 dict begin
    /a exch def
    /b exch def
    a type b type eq {
        a type /dicttype eq {
            a length b length eq {
                true
                <<
                    a {
                        pop
                        true
                    } forall
                    b {
                        pop
                        true
                    } forall
                >>
                {
                    pop
                    /k exch def
                    a k known {
                        b k known {
                            a k get b k get deepeq not {
                                pop false
                            } if
                        } {
                            pop false
                        } ifelse
                    } {
                        pop false
                    } ifelse
                } forall
            } {
                false
            } ifelse
        } {
            a type dup /arraytype eq exch /stringtype eq or {
                a length b length eq {
                    true
                    0 1 a length 1 sub {
                        dup a exch get exch b exch get deepeq not {
                            pop false
                            exit
                        } if
                    } for
                } {
                    false
                } ifelse
            } {
                a b eq
            } ifelse
        } ifelse
    } {
        false
    } ifelse
    end
} bind def

/test.end {
    ( ) print
    test.count 0 gt {
        (Passed ) print
        test.pass (...) cvs print
        (/) print
        test.count (...) cvs print
        ( \() print
        test.pass 100 mul test.count idiv (...) cvs print
        (%\)) print
        (\r\n) print
    } if
} bind def

/gcd {
    {
        dup
        3 1 roll
        mod
        dup 0 eq {
            pop exit
        } if
    } loop
} bind def

/a2s {
    2 dict begin
    /i exch def
    i length dup string /o exch def
    1 sub 0 exch 1 exch {
        dup i 3 -1 roll get o 3 1 roll put
    } for
    o
    end
} bind def

/strconcat % (a) (b) -> (ab)  
{
    [
        3 -1 roll
        s2a aload length
        2 add -1 roll
        s2a aload pop
    ] a2s
} bind def

/test.start {
    print (:) print
    /test.pass 0 def
    /test.count 0 def
    count /test.stack exch def
} bind def

/lcm {
    dup 3 -1 roll
    dup 4 -1 roll
    gcd idiv mul
} bind def


% end included library code

/rationalnumbers {
    str2rat exch str2rat deepeq
} bind def

/str2rat {
    0 dict begin
    /a exch def
    /fixedpart 0 string def
    /repeatpart 0 string def
    a (\() search {
        /fixedpart exch def
        pop
        (\)) search {
            /repeatpart exch def
            pop pop
        } {
            pop
        } ifelse
    } {
        pop
        /fixedpart a def
        /repeatpart (0) def
    } ifelse
    fixedpart (.) search {
        dup length /point exch def
        /tens fixedpart length point sub 1 sub def
        exch pop exch strconcat /n exch def
        /v [
            n cvi
            10 tens exp cvi
        ] def
        /repeatd 10 repeatpart length exp cvi 1 sub def
        /w [
            repeatpart cvi
            10 tens exp cvi repeatd mul
        ] def
        v w rat.add
    } {
        pop
        [ 0 0 ]
    } ifelse
    end
} bind def

/rat.reduce {
    0 dict begin
    dup
    aload pop gcd /g exch def
    { g idiv } map
    end
} bind def

/rat.add {
    0 dict begin
    /b exch def
    /a exch def
    /l a 1 get b 1 get lcm def
    [
        a 0 get l mul a 1 get idiv
        b 0 get l mul b 1 get idiv
        add
        l
    ]
    rat.reduce
    end
} bind def

(rationalnumbers) test.start
(0.(12)) (0.(121)) rationalnumbers not test
(0.1(23)) (0.12(32)) rationalnumbers test
(0.1(234)) (0.12(342)) rationalnumbers test
(12.99(99)) (13.) rationalnumbers test
(0.(123)) (0.1(231)) rationalnumbers test
test.end
