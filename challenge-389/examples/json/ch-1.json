    "name": "Reorder Notes"
  },
  "input_vars": [ "$melody" ],
  "examples": [
    {
      "name": "Example 1",
      "in": [["Mozart", ["C", "D", "E", "F", "G", "A", "B"],
          [7, 1, 6, 2, 5, 3, 4]]],
      "out": [["D", "F", "A", "B", "G", "E", "C"]]
    },
    {
      "name": "Example 2",
      "in": [["Chopin", ["C", "C#", "D", "D#", "E", "F"],
          [6, 5, 4, 3, 2, 1]]],
      "out": [["F", "E", "D#", "D", "C#", "C"]]
    },
    {
      "name": "Example 3",
      "in": [["Vivaldi", ["A", "B", "C", "D", "E"], [1, 2, 3, 4, 5]]],
      "out": [["A", "B", "C", "D", "E"]]
    },
    {
      "name": "Example 4",
      "in": [["Debussy", ["C", "D", "F", "G", "A"], [1, 3, 5, 2, 4]]],
      "out": [["C", "G", "D", "A", "F"]]
    },
    {
      "name": "Example 5",
      "in": [["Stravinsky", ["C#"], [1]]],
      "out": [["C#"]]
    }
  ]
