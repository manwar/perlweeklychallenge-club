{
  "challenge": {
    "week": 389,
    "task": 1,
    "name": "Reorder Notes"
  },
  "input_vars": [ "$melody" ],
  "examples": [
    {
      "name": "Example 1",
      "in": [
        ["Bach",
          ["C", "D", "E", "F#", "G", "A", "B"],
          [7, 1, 6, 2, 5, 3, 4]]
      ],
      "out": [ "BACH => D F# A B G E C" ]
    },
    {
      "name": "Example 2",
      "in": [ ["Beethoven", ["C", "D", "F#", "G", "Ab"], [1, 3, 5, 2, 4]] ],
      "out": [ "BEETHOVEN => C G D Ab F#" ]
    },
    {
      "name": "Example 3",
      "in": [
        ["Brahms",
          ["C", "Db", "Eb", "F", "G", "Ab", "Bb", "C", "D"],
          [9, 3, 7, 1, 8, 5, 2, 6, 4]]
      ],
      "out": [ "BRAHMS => F Bb Db D Ab C Eb G C" ]
    },
    {
      "name": "Example 4",
      "in": [
        ["Bruckner",
          ["G", "F#", "Bb", "C", "D", "Eb", "F"],
          [4, 7, 2, 6, 1, 5, 3]]
      ],
      "out": [ "BRUCKNER => D Bb F G Eb C F#" ]
    },
    {
      "name": "Example 5",
      "in": [ ["Berg", ["C#"], [1]] ],
      "out": [ "BERG => C#" ]
    }
  ]
}
