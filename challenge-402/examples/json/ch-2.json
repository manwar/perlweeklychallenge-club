{
  "challenge": {
    "week": 402,
    "task": 2,
    "name": "Circular String Rotations"
  },
  "input_vars": [ "$str", "@directions" ],
  "examples": [
    {
      "name": "Example 1",
      "in": ["hello", [[1, 3], [0, 3]]],
      "out": ["hello"]
    },
    {
      "name": "Example 2",
      "in": ["abcd", [[1, 6]]],
      "out": ["cdab"]
    },
    {
      "name": "Example 3",
      "in": ["coding", [[0, 4], [1, 2]]],
      "out": ["dingco"]
    },
    {
      "name": "Example 4",
      "in": ["xyz", [[0, 2], [0, 2], [1, 1]]],
      "out": ["xyz"]
    },
    {
      "name": "Example 5",
      "in": ["z", [[0, 5], [1, 9]]],
      "out": ["z"]
    }
  ]
}
