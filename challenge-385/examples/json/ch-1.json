{
  "challenge": {
    "week": 385,
    "task": 1,
    "name": "Uncommon Words"
  },
  "input_vars": [ "$sentence1", "$sentence2" ],
  "examples": [
    {
      "name": "Example 1",
      "in": ["apple banana apple", "banana orange"],
      "out": ["orange"]
    },
    {
      "name": "Example 2",
      "in": ["cat dog", "bird fish"],
      "out": ["cat", "dog", "bird", "fish"]
    },
    {
      "name": "Example 3",
      "in": ["the quick brown fox", "the quick"],
      "out": ["brown", "fox"]
    },
    {
      "name": "Example 4",
      "in": ["hello", "hello"],
      "out": []
    },
    {
      "name": "Example 5",
      "in": ["blue blue red", "red green green yellow"],
      "out": ["yellow"]
    }
  ]
}
