%!PS

% begin included library code
% see https://codeberg.org/Firedrake/postscript-libraries/
/test {
    /test.count test.count 1 add def
    {
        /test.pass test.pass 1 add def
    } {
        ( ) print
        test.count (....) cvs print
        (-fail) print
    } ifelse
    count /test.stack2 exch def
    test.stack test.stack2 ne {
        print
        (Warning: stack deviation ) print
        test.stack2 test.stack sub print
        (\r\n) print
    } if
} bind def

/a2s {
    2 dict begin
    /i exch def
    i length dup string /o exch def
    1 sub 0 exch 1 exch {
        dup i 3 -1 roll get o 3 1 roll put
    } for
    o
    end
} bind def

/test.start {
    print (:) print
    /test.pass 0 def
    /test.count 0 def
    count /test.stack exch def
} bind def

/s2a {
    [ exch { } forall ]
} bind def

/strsplit % (ajbjc) (j) -> [ (a) (b) (c) ]
{
    1 dict begin
    /sep exch def
    [ exch
      {
          dup length 0 eq {
              pop
              exit
          } {
              sep search {
                  exch pop
                  dup length 0 eq {
                      pop
                  } {
                      exch
                  } ifelse
              } {
                  ()
              } ifelse
          } ifelse
      } loop
    ]
    end
} bind def

/alloccvs {
    2 dict begin
    /n exch def
    /a 1 def
    n
    dup 0 lt {
        /a a 1 add def
        neg
    } if
    {
        dup 10 lt {
            exit
        } if
        /a a 1 add def
        10 idiv
    } loop
    pop
    n a string cvs
    end
} bind def

/strconcat % (a) (b) -> (ab)  
{
    [
        3 -1 roll
        s2a aload length
        2 add -1 roll
        s2a aload pop
    ] a2s
} bind def

/test.end {
    ( ) print
    test.count 0 gt {
        (Passed ) print
        test.pass (...) cvs print
        (/) print
        test.count (...) cvs print
        ( \() print
        test.pass 100 mul test.count idiv (...) cvs print
        (%\)) print
        (\r\n) print
    } if
} bind def


% end included library code

/parseone {
    0 dict begin
    /a exch def
    a (\() search {
        pop
        pop
        /a exch def
    } {
        pop
    } ifelse
    a (\)) search {
        /a exch def
        pop
        pop
    } {
        pop
    } ifelse
    a (i) search {
        /a exch def
        pop
        pop
    } {
        pop
    } ifelse
    a cvi
} bind def

/parsecomplex {
    (+) strsplit
    aload pop
    parseone
    exch
    parseone
    exch
    2 array astore
} bind def

/complexnumber {
    0 dict begin
    parsecomplex
    aload pop
    /d exch def
    /c exch def
    parsecomplex
    aload pop
    /b exch def
    /a exch def
    /ca a c mul b d mul sub def
    /cb a d mul b c mul add def
    ca alloccvs
    (+) strconcat
    cb 0 lt {
        (\() strconcat
    } if
    cb alloccvs strconcat
    cb 0 lt {
        (\)) strconcat
    } if
    (i) strconcat
    end
} bind def

(complexnumber) test.start
(1+1i) (1+1i) complexnumber (0+2i) eq test
(1+(-1)i) (1+(-1)i) complexnumber (0+(-2)i) eq test
(0+3i) (0+4i) complexnumber (-12+0i) eq test
(3+4i) (3+(-4)i) complexnumber (25+0i) eq test
(50+-20i) (-10+30i) complexnumber (100+1700i) eq test
test.end
