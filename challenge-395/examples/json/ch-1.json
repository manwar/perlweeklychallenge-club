    "name": "Complex Number"
  },
  "input_vars": [ "$num1", "$num2" ],
  "examples": [
    {
      "name": "Example 1",
      "in": ["1+1i", "1+1i"],
      "out": ["0+2i"]
    },
    {
      "name": "Example 2",
      "in": ["1+(-1)i", "1+(-1)i"],
      "out": ["0+(-2)i"]
    },
    {
      "name": "Example 3",
      "in": ["0+3i", "0+4i"],
      "out": ["-12+0i"]
    },
    {
      "name": "Example 4",
      "in": ["3+4i", "3+(-4)i"],
      "out": ["25+0i"]
    },
    {
      "name": "Example 5",
      "in": ["50+(-20)i", "-10+30i"],
      "out": ["100+1700i"]
    }
  ]
